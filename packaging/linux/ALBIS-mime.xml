<?xml version="1.0" encoding="UTF-8"?>
<!--
  Media types for the detector formats that have none registered.

  application/x-hdf (.h5, .hdf5) and image/tiff are already known to
  shared-mime-info, so declaring them here would only risk contradicting it;
  ALBIS just claims them in its desktop entry. CBF and EDF have no registered
  type at all, so without this file a file manager has nothing to associate
  ALBIS with.

  Both are matched by extension rather than by content. CBF begins with a
  comment block whose first bytes vary by writer, and EDF with an ASCII header
  that is not distinctive enough for a magic rule that would not also match
  unrelated text files.

  NeXus (.nxs) is deliberately not declared. Nothing claims *.nxs by name, so
  a NeXus file is recognised by its HDF5 signature as application/x-hdf, which
  ALBIS claims. A glob for *.nxs would also catch the phylogenetics NEXUS text
  format and retype it away from text/plain.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="image/x-cbf">
    <comment>Crystallographic Binary Format image</comment>
    <glob pattern="*.cbf"/>
  </mime-type>
  <mime-type type="image/x-edf">
    <comment>ESRF Data Format image</comment>
    <glob pattern="*.edf"/>
  </mime-type>
</mime-info>
