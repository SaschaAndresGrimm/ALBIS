# Refuse to install on a Node older than package.json "engines".
#
# Without this, an older npm quietly skips optional platform packages whose
# engines it cannot satisfy - notably @rolldown/binding-<platform> behind
# Vitest - and leaves a tree that installs "successfully" but fails at test
# time with "Cannot find module '@rolldown/binding-...'". Failing the install
# with EBADENGINE names the real problem instead.
#
# Only the install is gated: the npx-pinned scripts (lint:js, test:js,
# review:i18n) keep working on an older Node on PATH.
engine-strict=true
