.venv/
__pycache__/
*.pyc
node_modules/
.DS_Store
build/
dist/
logs/
*.h5
*.hdf5
*.cbf
*.cbf.gz
*.tiff
*.tif
*.edf
test_data/

# testdata/ holds committed fixtures, so it is exempt from the data-file
# patterns above. Without this the detector formats the tests decode would be
# silently dropped from a commit.
!testdata/**
# ...except what ALBIS writes there while it is run on testdata/ (the UI
# snapshots and manual checks do): Combine Frames output and the logs. One
# such file, in16c_010009_series_sum_*.h5, slipped into a commit.
testdata/*_series_sum_*
testdata/logs/
# The Detector tab's downloads ("Show images in ALBIS") land under
# detector/<address>/; four such files (38 MB) went into a commit.
testdata/detector/
*.coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Build stamp written at packaging time (see scripts/stamp_build.py)
/BUILD_COMMIT

# Runtime data root and local (non-example) config
/data/
albis.config.json

# AI assistant / nanoclaw files. Local settings and worktrees stay private;
# project skills (.claude/skills/) are shared with the repo.
.claude/*
!.claude/skills/
!.claude/settings.json
ALBIS_REVIEW.md
IMPROVEMENTS_SUMMARY.md
ROI_PLOT_ANALYSIS.md

# Personal agent instructions (e.g. local code-graph tooling): not shared.
# CLAUDE.md itself is shared; it imports AGENTS.md.
CLAUDE.local.md
graphify-out/
live-check.json
